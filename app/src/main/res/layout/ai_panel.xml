<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cf_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvAiTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 救场"
        android:textColor="@color/cf_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/cf_text_dim"
        android:textSize="12sp" />

    <com.classfox.droid.CaptionScrollView
        android:id="@+id/aiScroll"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvAiBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="@color/cf_text"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </com.classfox.droid.CaptionScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etFollowup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="追问，如：能不能再简单点"
            android:inputType="text"
            android:textColor="@color/cf_text"
            android:textColorHint="@color/cf_text_dim"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/cf_primary"
            android:text="发送"
            android:textColor="@color/cf_on_primary" />
    </LinearLayout>
</LinearLayout>
