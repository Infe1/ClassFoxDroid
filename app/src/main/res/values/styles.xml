<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CFNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cf_surface_var</item>
    </style>

    <style name="CFCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/cf_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cf_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="CFCardLabel" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/cf_text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
